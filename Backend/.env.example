# MongoDB Connection
# Get your MongoDB URI from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://username:password@cluster0.yiykwk6.mongodb.net/task-management-db

# JWT Secret for token signing
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here_replace_with_secure_value

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend CORS Origin (update if frontend runs on different port)
CORS_ORIGIN=http://localhost:5173
